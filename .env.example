# Copy to .env.testnet (NEVER commit that file). Secrets live here only.
# Public addresses live in config/testnet.public.json instead.

# SDK identity: main Stellar address for receive (and send later).
# Public G... shown in UI. Secret stays server-side, never VITE_ prefixed.
STELLAR_NETWORK=testnet
STELLAR_DESTINATION=
STELLAR_SECRET=
STELLAR_TESTNET_DESTINATION=
# Optional overrides
DUST_COLLECTOR_ADDRESS=
FORWARDER_CONTRACT_ID=
HORIZON_URL=
SOROBAN_RPC_URL=
TRUSTLINE_ALLOW_CREATION=false  # opt-in, default OFF
SPEND_CAP_XLM=2
# Real burn tx hash for full-auto receive (Base Sepolia -> Stellar testnet)
CIRCLE_TESTNET_BURN_TX=
# EVM burn automation (full-auto stage 2 only)
EVM_RPC_URL=https://sepolia.base.org
EVM_CHAIN_ID=84532
EVM_PRIVATE_KEY=
EVM_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EVM_MESSENGER_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
EVM_MAX_FEE=5000
# Circle Iris sandbox override (default https://iris-api-sandbox.circle.com)
CIRCLE_ATTESTATION_BASE_URL=
# Mirror keys used by apps/demo (see apps/demo/*.example for VITE_ variants)
STELLAR_NETWORK=              # testnet or mainnet
SIM_MODE=                     # true/false
SOROBAN_RPC_URL=              # https://soroban-testnet.stellar.org or https://soroban-mainnet.stellar.org
REPLAY_STORE_PATH=            # e.g. ./replay-store — dir created + chmod 700; file chmod 600

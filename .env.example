# Copy to .env.testnet (NEVER commit that file). Secrets live here only.
# Public addresses live in config/testnet.public.json instead.

# SDK identity: main Stellar address for receive (and send later).
# Public G... shown in UI. Secret stays server-side, never VITE_ prefixed.
STELLAR_NETWORK=testnet
STELLAR_DESTINATION=
STELLAR_SECRET=
STELLAR_TESTNET_DESTINATION=
# Optional overrides
DUST_COLLECTOR_ADDRESS=
FORWARDER_CONTRACT_ID=
HORIZON_URL=
SOROBAN_RPC_URL=
TRUSTLINE_ALLOW_CREATION=true
SPEND_CAP_XLM=2
# Real burn tx hash for full-auto receive (Base Sepolia -> Stellar testnet)
CIRCLE_TESTNET_BURN_TX=
# EVM burn automation (full-auto stage 2 only)
EVM_RPC_URL=
EVM_PRIVATE_KEY=
# Circle Iris sandbox override (default https://iris-api-sandbox.circle.com)
CIRCLE_ATTESTATION_BASE_URL=

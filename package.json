{
  "name": "anchorcctp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AnchorCCTP SDK — accept USDC from any CCTP-connected chain on Stellar with a single function call.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:demo": "npm run dev --workspace=@anchor-cctp/demo",
    "build:demo": "npm run build --workspace=@anchor-cctp/demo",
    "build:core": "npm run build --workspace=@anchor-cctp/core",
    "build:cli": "npm run build --workspace=@anchor-cctp/cli",
    "build": "npm run build --workspaces",
    "test": "jest --coverage",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "stellar",
    "cctp",
    "usdc",
    "circle",
    "anchor",
    "cross-chain",
    "soroban"
  ],
  "author": "Mother's Grace (Juen)",
  "license": "MIT"
}
